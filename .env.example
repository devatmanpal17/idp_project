OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=embeddinggemma
OLLAMA_CHAT_MODEL=llama3.2:3b
CHROMA_PERSIST_DIR=./data/chroma

# Production persistence (Supabase, Neon, or another managed PostgreSQL service).
# Leave unset to use local SQLite during development.
DATABASE_URL=

# Optional hosted Chroma server. Leave CHROMA_HOST unset for local Chroma.
CHROMA_HOST=
CHROMA_PORT=8000
CHROMA_SSL=false

# Patent-feature controls. Full coverage prevents retrieval of unwatched cue spans.
F1_COVERAGE_THRESHOLD=1.0
F1_ENABLED=true
F1_EMBED_BATCH_SIZE=32
# A high cosine boundary catches near duplicates without broadly masking a lesson.
A_NEAR_DUP_COS=0.97
A_SECONDS_PER_QUESTION=180
A_GRACE_SECONDS=120
# Exact brute-force video ranking is feasible at lecture scale.
B_VERIFY_EXACT=true
B_PROMPT_VERSION=video-answer-v1
# Budget and dwell defaults are conservative laptop starting points, not fitted optima.
C_RAM_BUDGET_MB=8192
C_PLAY_DWELL_S=30
C_HIDDEN_S=60
C_COOLDOWN_S=5
C_DEFAULT_KEEP_ALIVE=10m
# Micro size keeps short watched segments searchable; macro retains prior chunk size.
E_MICRO_WORDS=50
E_MACRO_WORDS=220
# Candidate containment admits trimmed clips; blocks need multiple complete cues.
D_CANDIDATE_JACCARD=0.15
D_MIN_BLOCK_WORDS=12
D_MIN_CONF=0.9
